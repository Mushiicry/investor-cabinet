{
  "crons": [
    {
      "path": "/api/daily-telegram-report",
      "schedule": "30 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/fear-greed",
      "destination": "https://api.alternative.me/fng/?limit=30"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
